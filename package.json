{
  "name": "fairbuy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "backend", "frontend"],
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @fairbuy/backend\" \"npm run dev -w @fairbuy/frontend\"",
    "build": "npm run typecheck && npm run build -w @fairbuy/frontend && npm run build -w @fairbuy/backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start": "node --env-file-if-exists=.env backend/dist/main.js",
    "db:migrate": "node --env-file-if-exists=.env --import tsx backend/src/migrate.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:blueprint": "node scripts/validate-blueprint.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "ajv": "^8.17.1",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5",
    "yaml": "^2.8.0"
  }
}

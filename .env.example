# Copy to .env. Never add keys to frontend/VITE_ variables.
FAIRBUY_MODE=live
# Meta Model API key (dev.meta.ai). Never add it to frontend/VITE_ variables.
MODEL_API_KEY=
ASK_MODEL=muse-spark-1.3-contributor
CONFIGURE_MODEL=muse-spark-1.3-contributor
DISCOVERY_MODEL=muse-spark-1.3-contributor
# Independent Buy-stage seller search configuration. Extraction uses this model
# at low effort; research uses SELLER_SEARCH_REASONING_EFFORT and high search context.
SELLER_SEARCH_MODEL=muse-spark-1.3-contributor
ASK_REASONING_EFFORT=low
CONFIGURE_REASONING_EFFORT=low
DISCOVERY_REASONING_EFFORT=medium
SELLER_SEARCH_REASONING_EFFORT=medium
# SEARCH_PROVIDER=meta uses Meta hosted web search (default; no extra key).
# SEARCH_PROVIDER=brave uses Brave Web Search (requires BRAVE_API_KEY).
SEARCH_PROVIDER=meta
# Required when SEARCH_PROVIDER=brave (as well as MODEL_API_KEY).
BRAVE_API_KEY=
# Brave Free allows one request/second. Calls are serialized with this gap.
# Set 0 only on a plan that permits higher concurrency.
BRAVE_MIN_INTERVAL_MS=1100
# On image HTTP 403, try the free wsrv.nl proxy. Shares the full public image
# URL (including query string) with wsrv.nl; use disabled to opt out.
IMAGE_PROXY_FALLBACK=wsrv
# Published discovery source catalog. Entries are stored only in PostgreSQL and
# reloaded from there on startup; a successful sync replaces every stored row.
CATALOG_URL=https://meta-hackers.github.io/fairbuy-sources-catalog/sources.json
# A fresh database is empty until the first sync. Admins trigger syncs from
# Backoffice → Sources; set true to also try once at startup.
CATALOG_SYNC_ON_START=false
# Optional, provisional Ask preview. Cloudflare credentials stay server-side.
# Ordinary Meta Llama Instruct models have no separate reasoning phase.
INSTANT_CLASSIFIER_PROVIDER=cloudflare
INSTANT_CLASSIFIER_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast
# Optional artwork selection only when category/name aliases have no match.
# Reuses Cloudflare credentials; does not change the Ask preview or main models.
# Switch to another Workers AI chat model supporting JSON object output here.
ILLUSTRATION_CLASSIFIER_PROVIDER=cloudflare
ILLUSTRATION_CLASSIFIER_MODEL=@cf/ibm-granite/granite-4.0-h-micro
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Local PostgreSQL. Production uses a Supabase Session pooler URL (port 5432),
# the dedicated fairbuy_app.<project-ref> login and
# sslmode=verify-full&sslrootcert=certs/supabase-ca.crt.
# Keep the actual production URL/password only in Render's DATABASE_URL secret.
DATABASE_URL=postgresql://fairbuy:fairbuy@localhost:5432/fairbuy
PORT=4000
# Optional password gate for a public deployment. Strongly recommended before sharing.
APP_ACCESS_TOKEN=
# Set to your exact https origin if using a custom domain; Render's origin is automatic.
APP_ORIGIN=

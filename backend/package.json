{
  "name": "@fairbuy/backend", "version": "1.0.0", "private": true, "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --env-file-if-exists=../.env.backoffice --import tsx --watch src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --external:express --external:express-rate-limit --external:helmet --external:pg --outfile=dist/main.js"
  },
  "dependencies": {
    "@fairbuy/core": "*", "express": "^5.1.0", "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0", "pg": "^8.16.0", "zod": "^4.1.0"
  },
  "devDependencies": { "@types/express": "^5.0.0", "@types/pg": "^8.15.0", "@types/supertest": "^6.0.0", "supertest": "^7.1.0" }
}
